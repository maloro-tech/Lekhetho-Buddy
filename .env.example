# Server-side only. Read by the Vite dev/preview process for POST /api/buddy.
# Never prefix this with VITE_. A VITE_ variable is bundled into the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave unset for the local demo. The service-role key must never be added here
# or anywhere the browser can read.
# VITE_DATA_BACKEND=supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
